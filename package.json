{
  "name": "system69-manager",
  "version": "1.1.1",
  "description": "Windows application, Node.js runtime, PATH and package management.",
  "author": "System69",
  "license": "MIT",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:desktop": "node scripts/desktop-smoke.cjs",
    "test:packaged": "node scripts/desktop-smoke.cjs --packaged",
    "test:install": "node scripts/install-smoke.cjs",
    "check": "node scripts/check.cjs",
    "pack": "electron-builder --win --dir",
    "dist": "electron-builder --win nsis",
    "build:native": "node scripts/build-native.cjs",
    "prepack": "npm run build:native",
    "predist": "npm run build:native",
    "test:bridge": "node scripts/bridge-smoke.cjs",
    "test:disk": "node scripts/disk-desktop-smoke.cjs",
    "test:disk:packaged": "node scripts/disk-desktop-smoke.cjs --packaged",
    "test:disk-delete": "node scripts/disk-delete-smoke.cjs",
    "test:disk-delete:packaged": "node scripts/disk-delete-smoke.cjs --packaged"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12",
    "@playwright/test": "^1.56.0"
  },
  "build": {
    "appId": "dev.system69.manager",
    "productName": "System69 Manager",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE",
      "assets/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "installer/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "include": "installer/chocolatey.nsh",
      "artifactName": "System69-Manager-Setup-${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "native-publish",
        "to": "bridge",
        "filter": [
          "**/*",
          "!**/*.pdb"
        ]
      }
    ]
  }
}
